{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make doctor)",
      "Bash(make help)",
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make cov)",
      "Bash(make hooks)",
      "Bash(make ports)",
      "Bash(make ps)",
      "Bash(make verify-infra)",
      "Bash(make kafka-topics)",
      "Bash(make logs *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(uv sync *)",
      "Bash(./mvnw -q test *)",
      "Bash(npm run lint *)",
      "Bash(npm run test *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(uv lock *)",
      "Bash(uv run pre-commit *)",
      "Bash(docker compose config *)",
      "Bash(make db-current)",
      "Bash(make db-history)",
      "Bash(make db-check)",
      "Bash(make db-verify)",
      "Bash(make test-integration)",
      "Bash(uv run python -m aeoi_synth summary *)",
      "Bash(make token *)",
      "Bash(make -s token *)",
      "Bash(make smoke)",
      "Bash(make llm-smoke)",
      "Bash(make service-token *)",
      "Bash(make -s service-token *)",
      "Bash(make rag-stats)",
      "Bash(make rag-eval)",
      "Bash(make rag-smoke)",
      "Bash(make docpack)",
      "Bash(make stop-rag)",
      "Bash(make rag-sweep)",
      "Bash(make rag-bench)",
      "Bash(make tools-smoke)",
      "Bash(make stop-tools)",
      "Bash(make stop-audit)"
    ],
    "ask": [
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(alembic upgrade *)",
      "Bash(alembic downgrade *)",
      "Bash(kubectl *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(make setup)",
      "Bash(make up *)",
      "Bash(make up)",
      "Bash(make down)",
      "Bash(make kafka-init)",
      "Bash(make clean *)",
      "Bash(make psql)",
      "Bash(make db-upgrade)",
      "Bash(make db-downgrade)",
      "Bash(make db-seed *)",
      "Bash(make db-seed)",
      "Bash(make db-revision *)",
      "Bash(make db-reset *)",
      "Bash(make db-users)",
      "Bash(make run-incident)",
      "Bash(make run-api)",
      "Bash(make dev)",
      "Bash(make run-llm *)",
      "Bash(make run-llm)",
      "Bash(make ollama-pull)",
      "Bash(ollama pull *)",
      "Bash(make rag-ingest)",
      "Bash(make rag-embed *)",
      "Bash(make rag-token)",
      "Bash(make run-rag)",
      "Bash(make rag-eval RERANK=1)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(docker system prune *)",
      "Bash(kubectl delete namespace *)",
      "Bash(rm -rf /*)",
      "Bash(cat secrets/*)"
    ]
  },
  "env": {
    "AEOI_ENV": "development",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-on-save.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
