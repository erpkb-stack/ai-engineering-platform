# Copy to .env (gitignored). docker compose reads it automatically.
# NO SECRETS HERE: passwords live in ./secrets/*.txt (created by `make setup`).

# Host ports. Non-default on purpose (5432/6379/9092 are often taken). Check: make ports
AEOI_PG_PORT=5433
AEOI_REDIS_PORT=6380
AEOI_KAFKA_PORT=9094

# Used by Python services when run on the host with `uv run`
AEOI_ENV=development
AEOI_LOG_LEVEL=INFO
# Keep these two in sync with the ports above:
AEOI_REDIS_URL=redis://localhost:6380/0
AEOI_KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# Phase 18a (ADR-029), ONLY with `make up PROFILE=kafka` (restart the two services after):
# AEOI_INCIDENT_EVENT_TRANSPORT=kafka   # incident-service publishes its outbox to Kafka
# AEOI_AUDIT_CONSUMER_ENABLED=true      # audit consumes incident.lifecycle
# Phase 20 (ADR-032): the tool-gateway reads the Java service-catalog instead of the JSON file
# AEOI_TOOLS_CATALOG_URL=http://localhost:8010
# Phase 23a (ADR-035): traces, metrics and logs to the collector (make obs-up first). Host runs
# use the value as written; compose and kind replace it with http://otel-collector:4318
# AEOI_OTEL_ENDPOINT=http://localhost:4318
# AEOI_DATABASE_URL is built by services from secrets/postgres_password.txt (Phase 3)

# LLM (Phase 5). Do NOT put the key in this file (it is exported to every make recipe). Use your shell
# (export ANTHROPIC_API_KEY=...) or in secrets/anthropic_api_key.txt (gitignored, chmod 600).
# Policy file: routing.yaml (Claude + Ollama) | routing.local.yaml ($0) | routing.test.yaml (fakes)
# AEOI_LLM_ROUTING_FILE=services/llm-gateway/config/routing.yaml

# Identity provider (Phase 17, ADR-027): `make keycloak-up`. Every service trusts these USER
# tokens. aeoi-cli (password grant) is a DEV-ONLY client for smokes: never list it in production.
AEOI_KC_PORT=8090
AEOI_OIDC_ISSUER=http://localhost:8090/realms/aeoi
AEOI_OIDC_CLIENTS=aeoi-console,aeoi-cli

# Containers (Phase 21, ADR-033): `make images`, `make apps-up`. The switches above apply to the
# containers too (compose reads this file); addresses inside Docker are compose names.
# AEOI_APP_MEM_LIMIT=2g   # measure first (make apps-peaks), then set real limits; default 512M
# LLM_ROUTING=routing.local.yaml   # llm-gateway container policy (default routing.yaml)
